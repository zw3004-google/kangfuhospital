# 文件权限必须为 600。含空格的值使用双引号；值中不要使用反引号或换行。
DB_URL=jdbc:postgresql://127.0.0.1:5432/kangfu
DB_USERNAME=kangfu
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
SERVER_PORT=8080
TZ=Asia/Shanghai

# 仅首次创建管理员时设为 true。首次登录并改密后改回 false，再重启服务。
APP_BOOTSTRAP_ADMIN_ENABLED=true
APP_BOOTSTRAP_ADMIN_EMPLOYEE_NO=ADMIN
APP_BOOTSTRAP_ADMIN_WECOM_USER_ID=admin
APP_INITIAL_PASSWORD=REPLACE_WITH_TEMP_ADMIN_PASSWORD

# 企业微信凭据不得写入安装包，应在服务器现场填写。
WECOM_CORP_ID=REPLACE_WITH_CORP_ID
WECOM_AGENT_ID=REPLACE_WITH_AGENT_ID
WECOM_SECRET=REPLACE_WITH_SECRET
WECOM_API_BASE=https://qyapi.weixin.qq.com

# 默认每天 08:00，Spring cron 为 秒 分 时 日 月 周。
APP_MESSAGING_DISCHARGE_CRON="0 0 8 * * *"
APP_MESSAGING_ARREARS_CRON="0 0 8 * * *"
